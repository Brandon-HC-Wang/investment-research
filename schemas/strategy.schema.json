{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-research:strategy:v1",
  "title": "Research strategy definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "enabled", "validation_state",
    "confidence", "created_on", "last_reviewed", "claim",
    "causal_mechanism", "expected_time_window", "minimum_validation_periods",
    "minimum_validation_unit", "screen_ids", "confirmation_signals",
    "rejection_signals"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 3},
    "enabled": {"type": "boolean"},
    "validation_state": {"enum": ["idea", "testing", "validated", "monitoring", "rejected", "archived"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "created_on": {"type": "string", "format": "date"},
    "last_reviewed": {"type": "string", "format": "date"},
    "claim": {"type": "string", "minLength": 20},
    "causal_mechanism": {"type": "string", "minLength": 20},
    "expected_time_window": {"type": "string", "minLength": 3},
    "minimum_validation_periods": {"type": "integer", "minimum": 1},
    "minimum_validation_unit": {"enum": ["quarters", "annual_cohorts", "runs"]},
    "screen_ids": {"$ref": "#/$defs/nonEmptyStringList"},
    "confirmation_signals": {"$ref": "#/$defs/nonEmptyStringList"},
    "rejection_signals": {"$ref": "#/$defs/nonEmptyStringList"}
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    }
  }
}
