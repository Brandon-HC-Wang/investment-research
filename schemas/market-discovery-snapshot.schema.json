{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-research:market-discovery-snapshot:v1",
  "title": "Official market discovery snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "adapter_id", "screen_id",
    "started_at", "finished_at", "status", "data_date",
    "minimum_displayed_yield_pct", "minimum_coverage_pct",
    "universe_count", "complete_count", "incomplete_count", "priority_count",
    "coverage_pct", "twse_yield_count", "twse_price_count",
    "tpex_yield_count", "tpex_price_count", "source_urls", "error_codes",
    "raw_artifacts", "discovery_path", "discovery_sha256", "summary_path",
    "human_review_required"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{9,127}$"},
    "adapter_id": {"const": "taiwan-market-discovery"},
    "screen_id": {"const": "forward-dividend-yield"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "partial", "failed"]},
    "data_date": {"type": "string", "format": "date"},
    "minimum_displayed_yield_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "minimum_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "universe_count": {"type": "integer", "minimum": 1},
    "complete_count": {"type": "integer", "minimum": 0},
    "incomplete_count": {"type": "integer", "minimum": 0},
    "priority_count": {"type": "integer", "minimum": 0},
    "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "twse_yield_count": {"type": "integer", "minimum": 1},
    "twse_price_count": {"type": "integer", "minimum": 1},
    "tpex_yield_count": {"type": "integer", "minimum": 1},
    "tpex_price_count": {"type": "integer", "minimum": 1},
    "source_urls": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "raw_artifacts": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "discovery_path": {"const": "market-discovery.csv"},
    "discovery_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary_path": {"const": "summary.md"},
    "human_review_required": {"const": true}
  }
}
