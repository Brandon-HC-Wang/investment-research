{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-research:screen:v1",
  "title": "Market screen definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "enabled", "definition_version",
    "definition_updated_on", "refresh_mode", "timezone",
    "routine_cadence_days", "stale_after_days", "minimum_coverage_pct",
    "target_yield_pct", "minimum_eps_coverage_x", "minimum_downside_yield_pct",
    "market_discovery_adapter", "source_snapshot_directory",
    "universe", "fallback_behavior", "strategy_ids", "required_filters",
    "ranking_factors", "warning_flags", "event_triggers", "primary_sources",
    "fallback_sources", "required_input_fields", "required_output_fields"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "enabled": {"type": "boolean"},
    "definition_version": {"type": "integer", "minimum": 1},
    "definition_updated_on": {"type": "string", "format": "date"},
    "refresh_mode": {"enum": ["remind_only", "explicit_run"]},
    "timezone": {"type": "string", "minLength": 3},
    "routine_cadence_days": {"type": "integer", "minimum": 1},
    "stale_after_days": {"type": "integer", "minimum": 0},
    "minimum_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "target_yield_pct": {"type": "number", "exclusiveMinimum": 0},
    "minimum_eps_coverage_x": {"type": "number", "exclusiveMinimum": 0},
    "minimum_downside_yield_pct": {"type": "number", "minimum": 0},
    "market_discovery_adapter": {"type": "string", "pattern": "^scripts/[a-z0-9_-]+\\.py$"},
    "source_snapshot_directory": {"const": "source-snapshots"},
    "universe": {"type": "string", "minLength": 10},
    "fallback_behavior": {"type": "string", "minLength": 10},
    "strategy_ids": {"$ref": "#/$defs/nonEmptyStringList"},
    "required_filters": {"$ref": "#/$defs/nonEmptyStringList"},
    "ranking_factors": {"$ref": "#/$defs/nonEmptyStringList"},
    "warning_flags": {"$ref": "#/$defs/nonEmptyStringList"},
    "event_triggers": {"$ref": "#/$defs/nonEmptyStringList"},
    "primary_sources": {"$ref": "#/$defs/nonEmptyStringList"},
    "fallback_sources": {"$ref": "#/$defs/nonEmptyStringList"},
    "required_input_fields": {"$ref": "#/$defs/nonEmptyStringList"},
    "required_output_fields": {"$ref": "#/$defs/nonEmptyStringList"}
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    }
  }
}
